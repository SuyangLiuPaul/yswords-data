{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yswords-data.netlify.app/schemas/news_verse_corpus.schema.json",
  "title": "News Verse Corpus",
  "description": "Curated catalog of Bible verses the daily-news pipeline picks from when matching a story to Scripture. Hand-authored; consumed by gemini-2.5-pro deep-match in scripts/refresh-news.mjs.",
  "type": "object",
  "required": ["verses"],
  "properties": {
    "_meta": {
      "type": "object",
      "properties": {
        "version": { "type": "number" },
        "description": { "type": "string" },
        "totalVerses": { "type": "number" },
        "categories": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "verses": {
      "type": "array",
      "minItems": 50,
      "items": { "$ref": "#/definitions/verse" }
    }
  },
  "definitions": {
    "verse": {
      "type": "object",
      "required": ["id", "reference", "textEn", "themeEn", "themeZh", "tags", "applies"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "reference": { "type": "string", "minLength": 3 },
        "textEn": { "type": "string", "minLength": 5 },
        "textZh": { "type": "string" },
        "textZh-Hans": { "type": "string", "minLength": 1 },
        "textZh-Hant": { "type": "string", "minLength": 1 },
        "themeEn": { "type": "string", "minLength": 1 },
        "themeZh": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "applies": { "type": "string", "minLength": 5 }
      },
      "additionalProperties": false
    }
  }
}
